# SecureWave backend environment template (Hetzner-only)

ENVIRONMENT=production
APP_VERSION=4.0.0+1
LOG_LEVEL=INFO

# Network
APP_URL=https://vpn.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# API + auth
ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_SECRET_64_PLUS_BYTES
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_SECRET_64_PLUS_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
COOKIE_SAMESITE=lax

# Encryption at rest
AUTH_ENCRYPTION_KEY=CHANGE_ME_VALID_FERNET_KEY
WG_ENCRYPTION_KEY=CHANGE_ME_VALID_FERNET_KEY

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://securewave:<DB_PASSWORD>@127.0.0.1:5432/securewave
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_SSL_MODE=require

# WireGuard
WG_DATA_DIR=/var/lib/securewave/wg
WG_AUTO_REGISTER_PEERS=true
WG_COMMAND_TIMEOUT=30
WG_SSH_USER=securewave
WG_SSH_KEY_PATH=/home/securewave/.ssh/id_rsa
SECUREWAVE_TUNNEL_DNS=94.140.14.14,94.140.15.15
SECUREWAVE_WG_KEEPALIVE=25
SECUREWAVE_PROFILE_TTL_SECONDS=3600
SERVER_KEY_ROTATION_DAYS=30

# Plan quotas + bandwidth targets (cost guardrails)
FREE_TIER_MONTHLY_GB=5
PREMIUM_TIER_MONTHLY_GB=0
FREE_TIER_SPEED_Mbps_DOWN=25
FREE_TIER_SPEED_Mbps_UP=10
PREMIUM_TIER_SPEED_Mbps_DOWN=250
PREMIUM_TIER_SPEED_Mbps_UP=100

# Multi-protocol gating + auth modes
SECUREWAVE_ENABLED_PROTOCOLS=wireguard,openvpn,ikev2
SECUREWAVE_ENFORCE_RUNTIME_CHECKS=true
SECUREWAVE_OPENVPN_SERVICE_UNITS=openvpn-server@server,openvpn-server@securewave,openvpn@server
SECUREWAVE_IKEV2_SERVICE_UNITS=strongswan-starter,strongswan,charon-systemd
SECUREWAVE_OPENVPN_AUTH_MODE=mtls
SECUREWAVE_IKEV2_AUTH_MODE=eap-mschapv2

# Rate limiting
REDIS_URL=redis://127.0.0.1:6379/0

# Stripe
STRIPE_SECRET_KEY=[REDACTED]
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRICE_BASIC_MONTHLY=price_change_me
STRIPE_PRICE_BASIC_YEARLY=price_change_me
STRIPE_PRICE_PREMIUM_MONTHLY=price_change_me
STRIPE_PRICE_PREMIUM_YEARLY=price_change_me
STRIPE_PRICE_ULTRA_MONTHLY=price_change_me
STRIPE_PRICE_ULTRA_YEARLY=price_change_me

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
FROM_EMAIL=no-reply@example.com

# Hetzner automation
HETZNER_API_TOKEN=change_me_hetzner_token
