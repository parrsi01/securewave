# ============================================================
# SecureWave VPN — Backend Environment Configuration
# Copy to .env and fill in production values
# ============================================================

# ── Core ─────────────────────────────────────────────────────
ENVIRONMENT=production
API_BASE_URL=https://api.your-domain.com/api
APP_URL=https://your-domain.com
DOMAIN=your-domain.com
LOG_LEVEL=INFO
APP_VERSION=1.0.0
TELEMETRY_ENABLED=true

# ── Database ─────────────────────────────────────────────────
# PostgreSQL recommended for production
DATABASE_URL=postgresql://securewave:PASSWORD@localhost:5432/securewave
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=3600
# DB_SSL_MODE=require

# ── Authentication ───────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=
WG_ENCRYPTION_KEY=
JWT_SECRET=[REDACTED]
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://your-domain.com

# ── Email (choose one provider) ──────────────────────────────
EMAIL_PROVIDER=smtp

# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=SecureWave VPN

# SendGrid (alternative)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxx

# ── Stripe Payments ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_BASIC_MONTHLY=price_xxxx
STRIPE_PRICE_BASIC_YEARLY=price_xxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxx
STRIPE_PRICE_ULTRA_MONTHLY=price_xxxx
STRIPE_PRICE_ULTRA_YEARLY=price_xxxx

# ── WireGuard VPN ────────────────────────────────────────────
VPN_SERVER_ENDPOINT=vpn.your-domain.com:51820
WG_SSH_KEY_PATH=/opt/securewave/.ssh/id_ed25519
WG_AUTO_REGISTER_PEERS=true

# ── SSL / TLS ────────────────────────────────────────────────
SSL_EMAIL=admin@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# ── Rate Limiting ────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
