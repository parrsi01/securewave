[Unit]
Description=SecureWave restricted WireGuard helper
After=network.target

[Service]
Type=simple
User=root
Group=securewave-wg
WorkingDirectory=/opt/securewave-beta/current
RuntimeDirectory=securewave-wg-helper
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/bin/python3 -m services.wireguard_helper
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/etc/wireguard

[Install]
WantedBy=multi-user.target
