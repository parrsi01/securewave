[Unit]
Description=SecureWave WireGuard Orphaned Peer Cleanup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/securewave
EnvironmentFile=/etc/securewave/env
Environment=PATH=/opt/securewave/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/securewave/.venv/bin/python /opt/securewave/scripts/ops/cleanup_wireguard_orphaned_peers.py --interface wg0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/securewave /var/log/securewave /tmp /etc/wireguard
StandardOutput=journal
StandardError=journal
SyslogIdentifier=securewave-wg-peer-cleanup

[Install]
WantedBy=multi-user.target
