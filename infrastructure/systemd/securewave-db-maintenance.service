[Unit]
Description=SecureWave Database Maintenance Service
After=network.target

[Service]
Type=oneshot
User=securewave
WorkingDirectory=/opt/securewave
ExecStart=/opt/securewave/infrastructure/database_maintenance_scheduler.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=securewave-db-maintenance

[Install]
WantedBy=multi-user.target
