[Unit]
Description=SecureWave VPN Backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=securewave
Group=securewave
WorkingDirectory=/opt/securewave
EnvironmentFile=/etc/securewave/env
ExecStart=/opt/securewave/venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8080 \
    --workers 2 \
    --no-access-log \
    --log-level warning
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/securewave /var/log/securewave /tmp
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=securewave-backend

[Install]
WantedBy=multi-user.target
