client
dev tun
proto udp
remote vpn.example.securewave 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-256-GCM
verb 3
<ca>
[REDACTED_CA_CERT_PEM]
</ca>
<cert>
[REDACTED_CLIENT_CERT_PEM]
</cert>
<key>
[REDACTED_CLIENT_PRIVATE_KEY]
</key>
<tls-crypt>
[REDACTED_TLS_CRYPT_KEY]
</tls-crypt>
