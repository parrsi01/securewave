ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/securewave
DB_SSL_MODE=require
ACCESS_TOKEN_SECRET=<secret-store-value>
WG_ENCRYPTION_KEY=<fernet-secret-store-value>
WIREGUARD_SERVER_ID=<single-active-server-id>
WG_SSH_USER=securewave
WG_SSH_KEY_PATH=/run/secrets/securewave-wireguard-ssh
WG_KNOWN_HOSTS_PATH=/run/secrets/securewave-wireguard-known-hosts
CORS_ORIGINS=https://securewaveapp.com
ALLOWED_HOSTS=api.securewaveapp.com
APP_VERSION=1.0.0-beta1
