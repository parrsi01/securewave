# =============================================================================
# SecureWave VPN - Production Environment Configuration
# Copy this to /etc/securewave/env (preferred) or .env and fill in the values
# =============================================================================

# Environment Mode
ENVIRONMENT=production
API_BASE_URL=https://api.securewave.app/api
TELEMETRY_ENABLED=true

# Database (PostgreSQL primary, SQLite fallback only with ALLOW_SQLITE_PRODUCTION=true)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<hostname>:5432/securewave
DB_SSL_MODE=require
# ALLOW_SQLITE_PRODUCTION=false

# Security - JWT Tokens (generate secure random values)
JWT_SECRET=<set-via-external-secret-store>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Security - CORS (no wildcards in production)
CORS_ORIGINS=https://securewave.app,https://www.securewave.app
ALLOWED_HOSTS=securewave.app,www.securewave.app

# Rate Limiting (use Redis for distributed rate limiting)
REDIS_URL=redis://username:password@hostname:6379/0

# =============================================================================
# WireGuard Configuration - REAL VPN MODE
# =============================================================================

# DNS servers for VPN clients
WG_DNS=1.1.1.1,1.0.0.1

# Local storage for config files (must be persistent)
WG_DATA_DIR=/app/wg_data

# WireGuard endpoint (single-server fallback)
VPN_SERVER_ENDPOINT=<wg-server-public-ip>:51820

# Encryption key for private keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
WG_ENCRYPTION_KEY=<your-fernet-key>
AUTH_ENCRYPTION_KEY=<your-fernet-key>

# Override server public key (optional, if not using per-server keys)
WG_SERVER_PUBLIC_KEY=<wg-server-public-key-base64>

# =============================================================================
# WireGuard Server Communication
# =============================================================================

# Live WireGuard Server Details (securewave-wg VM)
# Public IP: <wg-server-public-ip>
# WireGuard Port: 51820/UDP
# Server Public Key: <wg-server-public-key-base64>

# Option 1: SSH-based communication (recommended)
WG_SSH_USER=securewave
WG_SSH_KEY_PATH=/app/keys/securewave_wg_ssh_key.pem
WG_COMMAND_TIMEOUT=30

# Option 2: HTTP API (if management API is enabled on VPN servers)
# To enable: SSH to VM and run: systemctl enable --now wg-management-api
WG_API_KEY=<wg-management-api-key>
WG_API_PORT=8080

# Auto-register peers when config is generated
# Set to 'false' to require manual peer registration via admin API
WG_AUTO_REGISTER_PEERS=true
WG_MOCK_MODE=false
DEMO_MODE=false

# =============================================================================
# Payment Processing
# =============================================================================

# Stripe - use sk_test_... / pk_test_... for testing, sk_live_... / pk_live_... for production
STRIPE_SECRET_KEY=<set-via-external-secret-store>
STRIPE_WEBHOOK_SECRET=<set-via-external-secret-store>
STRIPE_PUBLISHABLE_KEY=<set-via-external-secret-store>

# Stripe Price IDs (create in Stripe Dashboard > Products)
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_YEARLY=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...
STRIPE_PRICE_ULTRA_MONTHLY=price_...
STRIPE_PRICE_ULTRA_YEARLY=price_...
PAYMENTS_MOCK=false

PAYPAL_CLIENT_ID=<your-paypal-client-id>
PAYPAL_CLIENT_SECRET=<your-paypal-client-secret>
PAYPAL_MODE=live

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASSWORD=<smtp-password>
SMTP_FROM_EMAIL=noreply@securewave.app
FROM_EMAIL=noreply@securewave.app
FROM_NAME=SecureWave VPN

# =============================================================================
# Application Settings
# =============================================================================

PORT=8000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
APP_URL=https://securewave.app

# =============================================================================
# Monitoring & Logging
# =============================================================================

# Sentry (optional)
SENTRY_DSN=https://...@sentry.io/...

# =============================================================================
# ML Models (optional)
# =============================================================================

QOS_MODEL_PATH=data/models/qos_model.json
RISK_MODEL_PATH=data/models/risk_model.json
