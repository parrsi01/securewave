ENVIRONMENT=production
PORT=8000

DATABASE_URL=postgresql+psycopg2://user:password@host:5432/securewave
REDIS_URL=redis://user:password@host:6379/0

ACCESS_TOKEN_SECRET=<generate-with-secrets-token_urlsafe>
REFRESH_TOKEN_SECRET=<generate-with-secrets-token_urlsafe>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

AUTH_ENCRYPTION_KEY=<fernet-key>
WG_ENCRYPTION_KEY=<fernet-key>
WG_DATA_DIR=/wg
SECUREWAVE_TUNNEL_DNS=94.140.14.14,94.140.15.15

CORS_ORIGINS=https://api.securewaveapp.com
ALLOWED_HOSTS=api.securewaveapp.com

WG_SSH_USER=securewave
WG_SSH_KEY_PATH=/app/keys/wg_server.pem
WG_COMMAND_TIMEOUT=30
WG_API_KEY=
WG_API_PORT=8080
WG_AUTO_REGISTER_PEERS=true
