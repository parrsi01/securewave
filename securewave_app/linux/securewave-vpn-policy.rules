// Polkit rules file for SecureWave VPN.
// Install to /etc/polkit-1/rules.d/50-securewave-vpn.rules
//
// Allows members of the 'sudo' group to run wg-quick, openvpn, and nmcli
// via pkexec without an interactive password prompt.  This avoids the need
// for a running polkit authentication agent, which many minimal Linux
// desktops do not provide out of the box.

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        subject.isInGroup("sudo")) {
        var cmd = action.lookup("command_line") || action.lookup("program") || "";
        if (cmd.indexOf("wg-quick") >= 0 ||
            cmd.indexOf("openvpn") >= 0 ||
            cmd.indexOf("nmcli") >= 0) {
            return polkit.Result.YES;
        }
    }
});
