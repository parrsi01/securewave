#!/usr/bin/env bash
set -euo pipefail

WG_IFACE="sw-wg"
WIREGUARD_ROUTING_TABLE=51820
WIREGUARD_POLICY_PRIORITY=32764
WIREGUARD_SUPPRESS_PRIORITY=32765
WIREGUARD_IPV4_KILL_SWITCH_COMMENT="securewave-wireguard-ipv4-kill-switch-v1"
WIREGUARD_IPV6_BLOCK_COMMENT="securewave-wireguard-ipv6-block-v1"

usage() {
  cat >&2 <<'EOF'
Usage:
  securewave-wg-quick probe wireguard
  securewave-wg-quick up <config-path>
  securewave-wg-quick down <config-path>
  securewave-wg-quick policy-clear-link sw-wg
  securewave-wg-quick wireguard-transfer
  securewave-wg-quick wireguard-peer-handshakes
EOF
}

require_safe_config_path() {
  local path="$1"
  case "$path" in
    /home/*/.config/securewave/*.conf|/root/.config/securewave/*.conf|/run/securewave/*.conf|/etc/wireguard/*.conf)
      return 0
      ;;
    *)
      echo "securewave-wg-quick: refusing unsafe config path '$path'" >&2
      exit 64
      ;;
  esac
}

clear_iptables_rule() {
  local binary="$1"
  shift
  if ! command -v "$binary" >/dev/null 2>&1; then
    return 0
  fi
  while "$binary" -D "$@" >/dev/null 2>&1; do
    :
  done
}

clear_policy_state() {
  while ip -4 rule del pref "$WIREGUARD_POLICY_PRIORITY" >/dev/null 2>&1; do :; done
  while ip -4 rule del pref "$WIREGUARD_SUPPRESS_PRIORITY" >/dev/null 2>&1; do :; done
  while ip -6 rule del pref "$WIREGUARD_POLICY_PRIORITY" >/dev/null 2>&1; do :; done
  while ip -6 rule del pref "$WIREGUARD_SUPPRESS_PRIORITY" >/dev/null 2>&1; do :; done
  ip -4 route flush table "$WIREGUARD_ROUTING_TABLE" >/dev/null 2>&1 || true
  ip -6 route flush table "$WIREGUARD_ROUTING_TABLE" >/dev/null 2>&1 || true
  clear_iptables_rule iptables OUTPUT ! -o "$WG_IFACE" -m mark ! --mark 0xca6c -m addrtype ! --dst-type LOCAL -m comment --comment "$WIREGUARD_IPV4_KILL_SWITCH_COMMENT" -j REJECT
  clear_iptables_rule ip6tables OUTPUT -d 2000::/3 -m mark ! --mark 0xca6c -m comment --comment "$WIREGUARD_IPV6_BLOCK_COMMENT" -j REJECT --reject-with icmp6-adm-prohibited
  ip route flush cache >/dev/null 2>&1 || true
  ip -6 route flush cache >/dev/null 2>&1 || true
}

if [[ $# -lt 1 ]]; then
  usage
  exit 64
fi

action="$1"
shift

case "$action" in
  probe)
    [[ $# -eq 1 && "$1" == "wireguard" ]] || {
      usage
      exit 64
    }
    command -v wg >/dev/null 2>&1
    command -v wg-quick >/dev/null 2>&1
    command -v ip >/dev/null 2>&1
    exit 0
    ;;
  up)
    [[ $# -eq 1 ]] || {
      usage
      exit 64
    }
    config="$1"
    require_safe_config_path "$config"
    wg-quick down "$WG_IFACE" >/dev/null 2>&1 || true
    clear_policy_state
    exec wg-quick up "$config"
    ;;
  down)
    [[ $# -eq 1 ]] || {
      usage
      exit 64
    }
    config="$1"
    require_safe_config_path "$config"
    wg-quick down "$config" >/dev/null 2>&1 || wg-quick down "$WG_IFACE" >/dev/null 2>&1 || true
    clear_policy_state
    exit 0
    ;;
  policy-clear|policy-clear-link)
    [[ $# -eq 0 || "$1" == "$WG_IFACE" ]] || {
      usage
      exit 64
    }
    clear_policy_state
    exit 0
    ;;
  policy-ensure|nm-unmanaged|nm-reset)
    exit 0
    ;;
  wireguard-transfer)
    [[ $# -eq 0 ]] || {
      usage
      exit 64
    }
    exec wg show "$WG_IFACE" transfer
    ;;
  wireguard-peer-handshakes)
    [[ $# -eq 0 ]] || {
      usage
      exit 64
    }
    exec wg show "$WG_IFACE" latest-handshakes
    ;;
  *)
    echo "securewave-wg-quick: unsupported WireGuard-only action '$action'" >&2
    exit 64
    ;;
esac
