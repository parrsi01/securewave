#!/usr/bin/env bash
set -euo pipefail

readonly INTERFACE="sw-wg"
readonly ROUTING_TABLE="51820"
readonly IPV4_COMMENT="securewave-wireguard-ipv4-kill-switch-v1"
readonly IPV6_COMMENT="securewave-wireguard-ipv6-block-v1"
readonly RUNTIME_CONFIG="/run/securewave/sw-wg.conf"

usage() {
  cat >&2 <<'EOF'
Usage:
  securewave-wg-quick probe wireguard
  securewave-wg-quick up|down <config-path>
  securewave-wg-quick wireguard-transfer
EOF
}

[[ $# -ge 1 ]] || { usage; exit 64; }
action="$1"
shift

require_interface() {
  [[ "${1:-}" == "$INTERFACE" ]] || {
    echo "securewave-wg-quick: refusing an unexpected interface" >&2
    exit 64
  }
}

require_config() {
  local path="${1:-}"
  case "$path" in
    /home/*/.config/securewave/sw-wg.conf|/root/.config/securewave/sw-wg.conf)
      [[ -f "$path" && ! -L "$path" ]] || {
        echo "securewave-wg-quick: WireGuard configuration is missing" >&2
        exit 64
      }
      ;;
    *)
      echo "securewave-wg-quick: refusing an unexpected configuration path" >&2
      exit 64
      ;;
  esac
  if grep -Eiq '^[[:space:]]*(PreUp|PostUp|PreDown|PostDown|Table|SaveConfig)[[:space:]]*=' "$path"; then
    echo "securewave-wg-quick: configuration contains an unsupported privileged directive" >&2
    exit 64
  fi
}

clear_rule() {
  local command="$1"
  shift
  "$command" -D "$@" >/dev/null 2>&1 || true
}

clear_firewall() {
  clear_rule iptables OUTPUT ! -o "$INTERFACE" -m mark ! --mark "$ROUTING_TABLE" \
    -m addrtype ! --dst-type LOCAL -m comment --comment "$IPV4_COMMENT" -j REJECT
  clear_rule ip6tables OUTPUT -d 2000::/3 -m mark ! --mark "$ROUTING_TABLE" \
    -m comment --comment "$IPV6_COMMENT" -j REJECT --reject-with icmp6-adm-prohibited
}

ensure_firewall() {
  if ! iptables -C OUTPUT ! -o "$INTERFACE" -m mark ! --mark "$ROUTING_TABLE" \
      -m addrtype ! --dst-type LOCAL -m comment --comment "$IPV4_COMMENT" -j REJECT \
      >/dev/null 2>&1; then
    iptables -I OUTPUT 1 ! -o "$INTERFACE" -m mark ! --mark "$ROUTING_TABLE" \
      -m addrtype ! --dst-type LOCAL -m comment --comment "$IPV4_COMMENT" -j REJECT
  fi
  if ! ip6tables -C OUTPUT -d 2000::/3 -m mark ! --mark "$ROUTING_TABLE" \
      -m comment --comment "$IPV6_COMMENT" -j REJECT --reject-with icmp6-adm-prohibited \
      >/dev/null 2>&1; then
    ip6tables -I OUTPUT 1 -d 2000::/3 -m mark ! --mark "$ROUTING_TABLE" \
      -m comment --comment "$IPV6_COMMENT" -j REJECT --reject-with icmp6-adm-prohibited
  fi
}

prepare_runtime_config() {
  local source="$1"
  local temporary="${RUNTIME_CONFIG}.tmp.$$"
  install -d -o root -g root -m 0750 /run/securewave
  umask 077
  awk 'tolower($1) != "dns" { print }' "$source" > "$temporary"
  chmod 0600 "$temporary"
  mv -fT "$temporary" "$RUNTIME_CONFIG"
}

apply_dns() {
  local source="$1"
  local dns_line
  local dns_values=()
  dns_line="$(awk -F= 'tolower($1) ~ /^[[:space:]]*dns[[:space:]]*$/ { print $2; exit }' "$source" | xargs)"
  [[ -n "$dns_line" ]] || return 0
  [[ -x "$(command -v resolvectl 2>/dev/null || true)" ]] || return 0
  read -ra dns_values <<< "${dns_line//,/ }"
  resolvectl dns "$INTERFACE" "${dns_values[@]}" >/dev/null 2>&1 || return 0
  resolvectl domain "$INTERFACE" '~.' >/dev/null 2>&1 || true
}

clear_dns() {
  if command -v resolvectl >/dev/null 2>&1; then
    resolvectl revert "$INTERFACE" >/dev/null 2>&1 || true
  fi
}

case "$action" in
  probe)
    [[ $# -eq 1 && "$1" == wireguard ]] || { usage; exit 64; }
    command -v wg >/dev/null 2>&1
    command -v wg-quick >/dev/null 2>&1
    command -v ip >/dev/null 2>&1
    command -v iptables >/dev/null 2>&1
    command -v ip6tables >/dev/null 2>&1
    exit 0
    ;;
  up)
    [[ $# -eq 1 ]] || { usage; exit 64; }
    config="$1"
    require_config "$config"
    clear_dns
    wg-quick down "$RUNTIME_CONFIG" >/dev/null 2>&1 || true
    prepare_runtime_config "$config"
    wg-quick up "$RUNTIME_CONFIG"
    if ! ip link show dev "$INTERFACE" >/dev/null 2>&1; then
      wg-quick down "$config" >/dev/null 2>&1 || true
      exit 1
    fi
    if ! ensure_firewall; then
      wg-quick down "$RUNTIME_CONFIG" >/dev/null 2>&1 || true
      clear_firewall
      clear_dns
      rm -f "$RUNTIME_CONFIG"
      exit 1
    fi
    apply_dns "$config"
    ;;
  down)
    [[ $# -eq 1 ]] || { usage; exit 64; }
    config="$1"
    require_config "$config"
    clear_dns
    wg-quick down "$RUNTIME_CONFIG" >/dev/null 2>&1 || true
    wg-quick down "$config" >/dev/null 2>&1 || true
    clear_firewall
    rm -f "$RUNTIME_CONFIG"
    ;;
  wireguard-transfer)
    [[ $# -eq 0 ]] || { usage; exit 64; }
    exec wg show "$INTERFACE" transfer
    ;;
  *)
    usage
    exit 64
    ;;
esac
