function commandHasArg(commandLine, arg) {
    var escaped = arg.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    var pattern = new RegExp("(^|\\s)" + escaped + "(\\s|$)");
    return pattern.test(commandLine);
}

polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec") {
        return polkit.Result.NOT_HANDLED;
    }

    var configuredUser = "__SECUREWAVE_ALLOWED_USER__";
    var allowConfiguredUser =
        configuredUser != "__SECUREWAVE_ALLOWED_USER__" &&
        subject.user == configuredUser;

    if (!(allowConfiguredUser ||
          subject.user == "securewave" ||
          subject.isInGroup("sudo"))) {
        return polkit.Result.NOT_HANDLED;
    }

    var program = action.lookup("program");
    var commandLine = action.lookup("command_line") || "";

    if (program == "/usr/local/libexec/securewave-wg-quick") {
        return polkit.Result.YES;
    }

    if ((program == "/usr/bin/wg" || program == "/bin/wg") &&
        commandHasArg(commandLine, "show")) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
