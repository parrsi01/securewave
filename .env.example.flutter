# SecureWave Flutter app environment template
# Replace these placeholders with your local preview or production URLs.

LIVE_API_BASE_URL=https://api.your-domain.com
SECUREWAVE_API_BASE_URL=https://api.your-domain.com/api
SECUREWAVE_PORTAL_URL=https://your-domain.com/account
SECUREWAVE_UPGRADE_URL=https://your-domain.com/subscription

# Optional debugging switch: reset stored auth/session state at startup.
SECUREWAVE_RESET_SESSION_ON_BOOT=false
